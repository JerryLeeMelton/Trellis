8:["$","p",null,{"children":[["$","span",null,{"className":"project-page-label","children":"Challenge:"}],["$","$L35",null,{"href":"https://rewire.ai/","target":"_blank","rel":"noopener noreferrer","className":"project-page-text-link","children":"Rewire AI's"}]," ","app Pipsqueak Pro, now known as Polygon AI, offered powerful but highly technical and niche capabilities. However, its potential was hampered by an unfocused user interface design."]}]
9:["$","p",null,{"className":"project-page-intro-end","children":[["$","span",null,{"className":"project-page-label","children":"Solution:"}],"A rebranding and interface redesign to clarify UI sections, providing a more focused and cohesive user experience."]}]
a:["$","h4",null,{"children":"Original State"}]
b:["$","p",null,{"children":"Initially, Pipsqueak Pro featured three panels with various nested functions, lacking a clear workflow for users. Features were not intuitively grouped, and the absence of a dedicated designer prior to my hiring led to unfocused visual styling, further contributing to user confusion."}]
c:["$","$L4",null,{"src":"/images/casestudies/polygon/pipsqueakpro_main_screen.webp","alt":"Pipsqueak Pro Main Screen","width":1961,"height":1196}]
d:["$","div",null,{"className":"project-page-image-caption","children":"Pipsqueak Pro main interface screen before I joined the team"}]
e:["$","h4",null,{"children":"Redesign Process"}]
f:["$","h6",null,{"children":"Name and Logo"}]
10:["$","p",null,{"children":"The team chose the name Polygon AI to better reflect the software's capabilities, which involve annotating images with shapes known as regions of interest (R.O.I.s), and to align with the company's AI-focused direction. As the newly hired designer, I had the opportunity to lead the redesign process, which began with the application's logo."}]
11:["$","$L4",null,{"src":"/images/casestudies/polygon/pip_vs_poly_logos.webp","alt":"Polygon vs Pipsqueak Logos","width":1961,"height":1833}]
12:["$","div",null,{"className":"project-page-image-caption","children":"Old Pipsqueak Pro logo vs new Polygon AI logo"}]
13:["$","p",null,{"className":"project-page-intro-end","children":"After numerous sketches and iterations, we settled on a sleeker, edgier logo compared to the previous Pipsqueak Pro design. The angular logo aligned with the cutting-edge aesthetic we aimed for and set the creative direction for the interface design."}]
14:["$","h6",null,{"children":"Interface Redesign"}]
15:["$","$L4",null,{"src":"/images/casestudies/polygon/polygon_wireframes.webp","alt":"Polygon Wireframes","width":1961,"height":1196}]
16:["$","div",null,{"className":"project-page-image-caption","children":"Wireframe sketches for the Polygon AI interface redesign"}]
17:["$","p",null,{"children":"When approaching the redesign of the interface for Polygon, one of the significant challenges was the non-linear user workflow. Users frequently moved between sections, completing tasks in their unique order. It was crucial to maintain this flexibility while improving visual organization."}]
18:["$","p",null,{"className":"project-page-intro-end","children":"We retained the three-panel design but introduced icon-based buttons along the app's left and right borders for navigation. This created clear sections within the app while preserving a familiar layout for existing users."}]
19:["$","h4",null,{"children":"Additional Features"}]
1a:["$","h6",null,{"children":"Color Themes"}]
1b:["$","p",null,{"children":"As part of the improvements to the user interface, I was also responsible for adding color themes to Polygon AI. This not only polished the app but also allowed users to personalize the appearance according to their preferences. The implementation was extensible, paving the way for additional themes in the future."}]
1c:["$","h6",null,{"children":"In-App Tutorials"}]
1d:["$","p",null,{"children":"Recognizing the need for direct guidance on specialized features, I developed a series of guided in-app tutorials. These tutorials improved usability and user retention, which directly translated into increased revenue for the company."}]
1e:["$","h6",null,{"children":"Analytics"}]
1f:["$","p",null,{"className":"project-page-intro-end","children":"Another important feature that I created for Polygon was the ability to track user analytics data. This helped the team to better understand user behavior and any potential pain points in the user experience."}]
20:["$","h4",null,{"children":"Final Product"}]
21:["$","$L4",null,{"src":"/images/casestudies/polygon/polygon_main_screen.webp","alt":"Polygon AI final main screen","width":1961,"height":1196}]
22:["$","div",null,{"className":"project-page-image-caption","children":"Current Polygon AI main user interface"}]
23:["$","p",null,{"className":"project-page-intro-end","children":"Joining Rewire early in its development allowed me to make significant and impactful contributions to Polygon AI. I am extremely proud of my achievements with Polygon and am eager to apply the lessons learned to future projects."}]
